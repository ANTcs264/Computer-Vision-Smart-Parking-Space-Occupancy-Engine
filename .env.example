# ==========================================
# SMART PARKING AI - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and adjust values as needed.
# NEVER commit the real .env containing sensitive secrets to Git.

# --- SYSTEM & ENVIRONMENT ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production_32_bytes

# --- COMPUTER VISION ENGINE ---
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_TARGET_FPS=30
FRAME_SKIP=0
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.45
OCCUPANCY_HYSTERESIS_FRAMES=30
OCCUPANCY_OVERLAP_THRESHOLD=0.30

# --- FASTAPI BACKEND ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- POSTGRESQL DATABASE ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_parking_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_parking_db

# --- REDIS (CACHE & MESSAGE BROKER) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- FRONTEND CLIENT ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
