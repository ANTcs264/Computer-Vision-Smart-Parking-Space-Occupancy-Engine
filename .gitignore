# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
.env
.env.local
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyTorch / Models / Weights (keep large files out of Git)
*.pt
*.onnx
*.engine
*.weights
models/yolo/*.pt
models/yolo/*.onnx
!models/yolo/.gitkeep

# Datasets and Media
datasets/*
!datasets/.gitkeep
*.mp4
*.avi
*.mkv
*.mov

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Node & Frontend dependencies
node_modules/
frontend/dist/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & Cache local persistence
pgdata/
redisdata/

# Logs
logs/
*.log

# OS generated files
.DS_Store
Thumbs.db
# Local SQLite databases
*.db
*.sqlite
*.sqlite3